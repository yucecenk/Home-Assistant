# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur. .env GitHub'a GÖNDERİLMEZ.

# Zorunlu: https://console.groq.com -> API Keys
GROQ_API_KEY=gsk_...

# İsteğe bağlı: kullanılacak model (varsayılan openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# İsteğe bağlı: gerçek Tuya ampul (python -m tinytuya wizard ile alınır).
# Boş bırakılırsa devices.json okunur; o da yoksa sadece simülasyon çalışır.
TUYA_ID=
TUYA_KEY=
TUYA_IP=
TUYA_VERSION=3.5
TUYA_ODA=salon

# İsteğe bağlı davranış ayarları
# ITO_UYANDIRMA=0     # "Hey İTO" demeden de dinlesin
# ITO_TAKIP_SN=8      # cevaptan sonra adını söylemeden devam etme süresi (sn)
# ITO_SES=0           # mikrofon/hoparlör kullanma, sadece panelden yazı
